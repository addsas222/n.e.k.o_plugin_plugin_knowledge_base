# --- 运行期状态（宿主生成，不是源码）---------------------------------------
# config/plugin.toml 由宿主从 config.example.toml 逐字节复制而来，
# 用户改的是那一份。都不进仓库。
config/
data/
cache/
static/cache/

# --- 嵌入模型：不随仓库分发，约 86 MB --------------------------------------
# all-MiniLM-L6-v2 的 model.onnx 等文件。首次运行由 kb_model_download
# 从 hf-mirror.com 下载到插件数据目录；也可手动放进 models/。
# 解析顺序见 README「依赖关系」。
models/

# --- pytest tmp_path 残留目录 ----------------------------------------------
pytest-cache-files-*/
